    "columnName": "country",
    "expression": "with(value.trim(), v, if(or(v=='FR',v=='fr',v=='France',v=='france',v=='FRA'), 'FR', if(or(v=='DE',v=='de',v=='DEU',v=='Germany',v=='germany',v=='Allemagne'), 'DE', if(or(v=='ES',v=='es',v=='Spain',v=='spain',v=='Espagne',v=='ESP'), 'ES', if(or(v=='BE',v=='be',v=='BEL',v=='Belgium',v=='belgium',v=='Belgique'), 'BE', v)))))",
    "onError": "keep-original",
    "repeat": false,
    "repeatCount": 0,
    "description": "Country spellings -> FR/DE/ES/BE"
  },
  {
    "op": "core/text-transform",
    "engineConfig": {
      "facets": [],
      "mode": "row-based"
    },
    "columnName": "signup_date",
    "expression": "if(isNotNull(value.match(/\\d{2}\\/\\d{2}\\/\\d{4}/)), with(value.split('/'), p, p[2]+'-'+p[1]+'-'+p[0]), if(isNotNull(value.match(/\\d{2}-\\d{2}-\\d{4}/)), with(value.split('-'), p, p[2]+'-'+p[0]+'-'+p[1]), if(isNotNull(value.match(/\\d{4}\\/\\d{2}\\/\\d{2}/)), value.replace('/', '-'), value)))",
    "onError": "keep-original",
    "repeat": false,
    "repeatCount": 0,
    "description": "signup_date -> YYYY-MM-DD"
  },
  {
